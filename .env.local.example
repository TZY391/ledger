# Copy this to .env.local and fill in from your Supabase project settings
# (Project Settings → API). The anon key is safe to expose client-side
# because every table is locked down by Row Level Security (see schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
